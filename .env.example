# Fi x Zam API — Environment Variables
# Copy file ini ke .env lalu isi sesuai kebutuhan.

# ── Server ───────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
DEBUG=false

# ── API Metadata ─────────────────────────────────────────
API_AUTHOR=Lunifar
API_CONTACT=https://t.me/November2k

# ── Provider Native (blueprint routes/sonzai_native.py) ──
# Kebanyakan provider native jalan tanpa token.
# Beberapa pakai token/cookie opsional di bawah ini.

# SONZAI_ROOT=/home/ubuntu/aggregator      # path codebase provider (opsional)
# SONZAI_BASE=http://127.0.0.1:8585        # base proxy (opsional)
# GOODSHORT_TOKEN=                         # token GoodShort (opsional)
# REELSHORT_DEV_ID=                        # device id ReelShort (opsional)

# ── Provider lain (opsional — kosongkan jika tak dipakai) ─
# DRAMANOVA_TOKEN=
# DRAMANOVA_DEVICE=
# DRAKOR_COOKIE=
# FB_COOKIE=
# IG_COOKIE=
# NETSHORT_TOKEN=
